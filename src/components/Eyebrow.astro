---
// Section label with the brand's "ombak" (wave) motif, as used in the Tara x Mattel brand kit.
interface Props { text: string; dark?: boolean }
const { text, dark = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<span class="eyebrow"><img class="eyebrow-motif" src={`${base}/images/motifs/ombak-${dark ? 'white' : 'navy'}.svg`} alt="" width="24" height="24" />{text}</span>
