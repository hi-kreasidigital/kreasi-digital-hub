---
import Icon from './Icon.astro';
import { content } from '../data/content';
import { tools, categoryOrder, industryOrder, industryTools, journey, featured, type Lang } from '../data/tools';
import { flags, waLink, contact } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang];
const loginHref = flags.loginUrl ?? waLink(t.wa.login);
const LIMIT = 9;
const name = (id: string) => t.tools[id]?.name ?? id;
const short = (id: string) => t.tools[id]?.short ?? name(id);
const toolHref = (id: string) => {
  const tool = tools.find((x) => x.id === id);
  if (id === 'ai-video') return '#produk-lainnya';
  return waLink(tool?.live ? t.wa.learn(name(id)) : t.wa.notify(name(id)));
};
const heroTiles = ['prospek-hub', 'nota-pos', 'content-planner', 'akunting-umkm'];
const heroIcon: Record<string, string> = { 'prospek-hub': 'users', 'nota-pos': 'cart', 'content-planner': 'calendar', 'akunting-umkm': 'book' };
const initials = (n: string) => n.split(' ').map((w) => w[0]).slice(0, 2).join('');
---

<!-- HERO -->
<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="eyebrow">{t.hero.eyebrow}</span>
      <h1>{t.hero.title}</h1>
      <p class="lead">{t.hero.lead}</p>
      <div class="btn-row">
        <a class="btn btn-primary" href="#tools">{t.hero.ctaPrimary}</a>
        <a class="btn btn-outline" href="#industri">{t.hero.ctaSecondary}</a>
      </div>
      <ul class="ticks">
        {t.hero.points.map((p) => <li><span style="color: var(--ocean)"><Icon name="check" size={16} stroke={2.5} /></span>{p}</li>)}
      </ul>
    </div>
    <div class="mock" aria-hidden="true">
      <div class="mock-head">
        <div>
          <div class="mock-hello">{t.hero.mockHello}</div>
          <div class="mock-sub">{t.hero.mockSub}</div>
        </div>
        <span class="avatar">RA</span>
      </div>
      <div class="mock-grid">
        {heroTiles.map((id, i) => (
          <div class="mock-tile">
            <span class={i === 3 ? 'icon-box dark' : 'icon-box'}><Icon name={heroIcon[id]} /></span>
            <div><strong>{name(id)}</strong><span>{t.hero.mockStates[id]}</span></div>
          </div>
        ))}
      </div>
      <div class="mock-add"><span>{t.hero.mockAdd}</span><span style="color: var(--ocean); font-weight: 700;">{t.hero.mockAddLink}</span></div>
    </div>
  </div>
</section>

<!-- MULTI TOOLS PLATFORM / JOURNEY -->
<section class="section bg-mist" aria-labelledby="journey-title">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">{t.journey.eyebrow}</span>
      <h2 class="h2" id="journey-title">{t.journey.title}</h2>
      <p class="lead">{t.journey.lead}</p>
    </div>
    <ol class="journey">
      {journey.map((j, i) => (
        <li>
          <div class="journey-top">
            <span class="journey-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="journey-line" aria-hidden="true"></span>
            {i === journey.length - 1 && <span style="color: var(--red)"><Icon name="flag" stroke={2.5} /></span>}
          </div>
          <div class="journey-card">
            <strong>{t.categories[j.cat]}</strong>
            {j.tools.map((id) => <a href="#tools" data-cat-link={j.cat}>{name(id)}</a>)}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- CATALOG -->
<section class="section border-top" id="tools" aria-labelledby="catalog-title">
  <div class="container">
    <div class="catalog-head">
      <div class="section-head">
        <span class="eyebrow">{t.catalog.eyebrow}</span>
        <h2 class="h2" id="catalog-title">{t.catalog.title}</h2>
      </div>
      <label class="search">{t.catalog.searchLabel}
        <span class="search-box">
          <Icon name="search" size={18} />
          <input type="search" id="tool-search" placeholder={t.catalog.searchPlaceholder} autocomplete="off" />
        </span>
      </label>
    </div>
    <div class="chips" role="group" aria-label={t.catalog.eyebrow}>
      <button class="chip" type="button" data-cat="all" aria-pressed="true">{t.catalog.all}<span class="count">{tools.length}</span></button>
      {categoryOrder.map((c) => (
        <button class="chip" type="button" data-cat={c} aria-pressed="false">{t.categories[c]}<span class="count">{tools.filter((x) => x.cat === c).length}</span></button>
      ))}
    </div>
    <div class="cards" id="tool-cards" aria-live="polite">
      {tools.map((tool, i) => (
        <article class="tool-card" data-cat={tool.cat} data-search={`${name(tool.id)} ${t.tools[tool.id].desc} ${t.categories[tool.cat]}`.toLowerCase()} hidden={i >= LIMIT}>
          <div class="tool-top">
            <span class="icon-box"><Icon name={tool.icon} /></span>
            <span class="tag">{t.catalog.typeTool}</span>
          </div>
          <div>
            <span class="tool-cat">{t.categories[tool.cat]}</span>
            <h3>{name(tool.id)}</h3>
            <p>{t.tools[tool.id].desc}</p>
          </div>
          <div class="tool-foot">
            <span class={tool.live ? 'status live' : 'status'}>{tool.live ? t.catalog.live : t.catalog.soon}</span>
            <a href={toolHref(tool.id)}>{tool.live ? t.catalog.learn : t.catalog.notify}</a>
          </div>
        </article>
      ))}
    </div>
    <p class="empty" id="tool-empty" hidden>{t.catalog.empty}</p>
    <div class="center">
      <button class="btn btn-primary" type="button" id="tool-more" aria-expanded="false" aria-controls="tool-cards" data-more={t.catalog.showAll(tools.length)} data-less={t.catalog.showLess}>{t.catalog.showAll(tools.length)}</button>
    </div>
  </div>
</section>

<!-- HOW IT WORKS -->
<section class="section bg-ocean on-dark" id="cara-kerja" aria-labelledby="how-title">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">{t.how.eyebrow}</span>
      <h2 class="h2" id="how-title">{t.how.title}</h2>
      <p class="lead">{t.how.lead}</p>
    </div>
    <ol class="steps">
      {t.how.steps.map((s, i) => (
        <li><span class="num">{String(i + 1).padStart(2, '0')}</span><strong>{s.title}</strong><span>{s.text}</span></li>
      ))}
    </ol>
  </div>
</section>

<!-- WHO IT'S FOR -->
<section class="section bg-mist" id="industri" aria-labelledby="industry-title">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">{t.industries.eyebrow}</span>
      <h2 class="h2" id="industry-title">{t.industries.title}</h2>
      <p class="lead">{t.industries.lead}</p>
    </div>
    <div class="industries">
      {industryOrder.map((key) => (
        <div class="industry">
          <h3>{t.industries.items[key].name}</h3>
          <span class="ex">{t.industries.items[key].ex}</span>
          <ul class="pills" aria-label={`${t.industries.toolsFor} ${t.industries.items[key].name}`}>
            {industryTools[key].map((id) => <li><a href={toolHref(id)}>{short(id)}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- USER STORIES -->
{flags.showTestimonials && (
  <section class="section" aria-labelledby="stories-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{t.testimonials.eyebrow}</span>
        <h2 class="h2" id="stories-title">{t.testimonials.title}</h2>
      </div>
      <div class="quotes" id="quotes">
        {t.testimonials.items.map((q, i) => (
          <figure class="quote" hidden={i >= 3}>
            <blockquote>“{q.text}”</blockquote>
            <figcaption>
              <span class="initials" aria-hidden="true">{initials(q.name)}</span>
              <span class="who"><strong>{q.name}</strong>{q.role} · {t.testimonials.uses} {name(q.tool)}</span>
            </figcaption>
          </figure>
        ))}
      </div>
      {t.testimonials.items.length > 3 && (
        <div class="center">
          <button class="btn btn-primary" type="button" id="quotes-more" aria-expanded="false" aria-controls="quotes" data-more={t.testimonials.showAll(t.testimonials.items.length)} data-less={t.testimonials.showLess}>{t.testimonials.showAll(t.testimonials.items.length)}</button>
        </div>
      )}
    </div>
  </section>
)}

<!-- BEST-SELLERS -->
<section class="section bg-sky" aria-labelledby="featured-title">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">{t.featured.eyebrow}</span>
      <h2 class="h2" id="featured-title">{t.featured.title}</h2>
    </div>
    <div class="featured">
      {featured.map((id) => {
        const tool = tools.find((x) => x.id === id)!;
        return (
          <article class="feat">
            <div class="feat-shot"><div class="shot-ph">{t.featured.screenshot} {name(id)}</div></div>
            <div class="feat-body">
              <span class="feat-cat">{t.categories[tool.cat]}</span>
              <h3>{name(id)}</h3>
              <p>{t.featured.desc[id]}</p>
              <div class="btn-row">
                <a class="btn btn-sm btn-navy" href={waLink(t.wa.learn(name(id)))}>{t.featured.learn} {name(id)}</a>
                <a class="text-link" href={loginHref}>{t.featured.login}</a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<!-- CUSTOM -->
<section class="section" id="custom" aria-labelledby="custom-title">
  <div class="container custom-grid">
    <div class="custom-copy">
      <div class="section-head">
        <span class="eyebrow">{t.custom.eyebrow}</span>
        <h2 class="h2" id="custom-title">{t.custom.title}</h2>
        <p class="lead">{t.custom.lead}</p>
      </div>
      <ul class="checklist">
        {t.custom.points.map((p) => <li><Icon name="check" size={20} stroke={2.5} />{p}</li>)}
      </ul>
    </div>
    <form class="form" id="custom-form" data-wa={contact.whatsappNumber} data-intro={t.custom.waIntro} data-label-name={t.custom.name} data-label-business={t.custom.business} data-label-need={t.custom.need}>
      <div class="row">
        <label>{t.custom.name}<input type="text" name="name" placeholder={t.custom.namePh} autocomplete="name" required /></label>
        <label>{t.custom.business}
          <select name="business" required>
            <option value="">{t.custom.businessPh}</option>
            {t.custom.options.map((o) => <option>{o}</option>)}
          </select>
        </label>
      </div>
      <label>{t.custom.need}<textarea name="need" rows="4" placeholder={t.custom.needPh} required></textarea></label>
      <button class="btn btn-primary" type="submit"><Icon name="whatsapp" size={20} />{t.custom.submit}</button>
      <p class="note">{t.custom.note}</p>
    </form>
  </div>
</section>

<!-- FAQ -->
<section class="section bg-ocean on-dark" id="faq" aria-labelledby="faq-title">
  <div class="container faq">
    <h2 class="h2" id="faq-title">{t.faq.title}</h2>
    <div class="faq-list">
      {t.faq.items.map((f) => (
        <details>
          <summary>{f.q}<span class="plus" aria-hidden="true">+</span></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- OTHER PRODUCTS -->
<section class="section" id="produk-lainnya" aria-labelledby="other-title">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">{t.other.eyebrow}</span>
      <h2 class="h2" id="other-title">{t.other.title}</h2>
    </div>
    <div class="others">
      {t.other.items.map((o, i) => (
        <article class="other">
          <span class="tag">{o.tag}</span>
          <h3>{o.title}</h3>
          <p>{o.desc}</p>
          <a class="btn btn-sm btn-primary" href={waLink(o.wa)}><Icon name={i === 0 ? 'globe' : 'video'} size={18} />{o.cta}</a>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- FINAL CTA -->
<section class="final bg-ocean on-dark" aria-labelledby="final-title">
  <div class="container final-inner">
    <div class="final-copy">
      <h2 class="h2" id="final-title">{t.finalCta.title}</h2>
      <p class="lead">{t.finalCta.lead}</p>
    </div>
    <div class="btn-row">
      <a class="btn btn-white" href="#industri">{t.finalCta.primary}</a>
      <a class="btn btn-ghost-light" href="#tools">{t.finalCta.secondary}</a>
    </div>
  </div>
</section>

<script>
  // ---- Catalog: category filter, search, show all ----
  const LIMIT = 9;
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.tool-card'));
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip'));
  const search = document.getElementById('tool-search') as HTMLInputElement | null;
  const more = document.getElementById('tool-more') as HTMLButtonElement | null;
  const empty = document.getElementById('tool-empty');
  let cat = 'all';
  let expanded = false;

  function render() {
    const q = (search?.value ?? '').trim().toLowerCase();
    const matches = cards.filter((c) => (cat === 'all' || c.dataset.cat === cat) && (!q || (c.dataset.search ?? '').includes(q)));
    const limited = !expanded && !q && cat === 'all';
    cards.forEach((c) => (c.hidden = true));
    matches.forEach((c, i) => (c.hidden = limited && i >= LIMIT));
    if (empty) empty.hidden = matches.length > 0;
    if (more) {
      const showButton = cat === 'all' && !q && matches.length > LIMIT;
      (more.parentElement as HTMLElement).hidden = !showButton;
      more.textContent = expanded ? more.dataset.less! : more.dataset.more!;
      more.setAttribute('aria-expanded', String(expanded));
    }
    chips.forEach((ch) => ch.setAttribute('aria-pressed', String(ch.dataset.cat === cat)));
  }
  chips.forEach((ch) => ch.addEventListener('click', () => { cat = ch.dataset.cat ?? 'all'; render(); }));
  search?.addEventListener('input', render);
  more?.addEventListener('click', () => { expanded = !expanded; render(); });
  document.querySelectorAll<HTMLAnchorElement>('[data-cat-link]').forEach((a) =>
    a.addEventListener('click', () => { cat = a.dataset.catLink ?? 'all'; if (search) search.value = ''; render(); })
  );
  render();

  // ---- Testimonials: show all ----
  const qMore = document.getElementById('quotes-more') as HTMLButtonElement | null;
  qMore?.addEventListener('click', () => {
    const open = qMore.getAttribute('aria-expanded') !== 'true';
    document.querySelectorAll<HTMLElement>('#quotes .quote').forEach((el, i) => (el.hidden = !open && i >= 3));
    qMore.setAttribute('aria-expanded', String(open));
    qMore.textContent = open ? qMore.dataset.less! : qMore.dataset.more!;
  });

  // ---- Custom form: open WhatsApp with the message filled in ----
  const form = document.getElementById('custom-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = new FormData(form);
    const ds = form.dataset;
    const text = [
      ds.intro,
      `${ds.labelName}: ${d.get('name')}`,
      `${ds.labelBusiness}: ${d.get('business')}`,
      `${ds.labelNeed}: ${d.get('need')}`,
    ].join('\n');
    window.open(`https://wa.me/${ds.wa}?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
  });
</script>
